{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "${PICOCLAW_WORKSPACE}",
      "restrict_to_workspace": true,
      "model_name": "agnes-flash",
      "max_tokens": 8192,
      "context_window": 131072,
      "temperature": 0.7,
      "max_tool_iterations": 20,
      "summarize_message_threshold": 20,
      "max_llm_retries": 2,
      "llm_retry_backoff_secs": 2
    }
  },
  "model_list": [
    {
      "model_name": "agnes-flash",
      "model": "litellm/agnes-2.5-flash",
      "api_keys": [
        "${AGNES_API_KEY}"
      ],
      "api_base": "https://apihub.agnes-ai.com/v1"
    },
    {
      "model_name": "agnes-pro",
      "model": "litellm/agnes-2.5-pro",
      "api_keys": [
        "${AGNES_API_KEY}"
      ],
      "api_base": "https://apihub.agnes-ai.com/v1"
    }
  ],
  "tools": {
    "mcp": {
      "enabled": true,
      "max_inline_text_chars": 16384,
      "discovery": {
        "enabled": true,
        "ttl": 30,
        "max_search_results": 20,
        "use_bm25": true,
        "use_regex": false
      },
      "servers": {
        "composio": {
          "enabled": true,
          "type": "streamable-http",
          "url": "${COMPOSIO_MCP_URL}",
          "headers": {
            "x-api-key": "${COMPOSIO_API_KEY}"
          }
        },
        "composio_bridge": {
          "enabled": true,
          "type": "stdio",
          "command": "python3",
          "args": [
            "/app/mcp/composio_bridge.py"
          ],
          "env": {
            "COMPOSIO_API_KEY": "${COMPOSIO_API_KEY}",
            "COMPOSIO_USER_ID": "${COMPOSIO_USER_ID}"
          },
          "deferred": false
        }
      }
    }
  },
  "channel_list": {
    "telegram": {
      "enabled": true,
      "type": "telegram",
      "allow_from": [
        "${TELEGRAM_ALLOWED_USER_ID}"
      ],
      "reasoning_channel_id": "",
      "settings": {
        "token": "${TELEGRAM_BOT_TOKEN}",
        "base_url": "",
        "proxy": "",
        "use_markdown_v2": false,
        "streaming": {
          "enabled": true
        }
      }
    }
  }
}
