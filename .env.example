# ============================================================
# PicoClaw — variables d'environnement / secrets
#
# En local  : copier en `.env` et sourcer avant de lancer le binaire.
# Sur HF Spaces : déclarer chaque ligne dans Settings > Variables and secrets
#                 (les valeurs sensibles en "Secret", pas en "Variable").
#
# Aucune de ces valeurs ne doit être committée.
# ============================================================

# --- Providers LLM ---
# Agnès AI (OpenAI-compatible, base https://apihub.agnes-ai.com/v1)
AGNES_API_KEY=
# Optionnels, si tu ajoutes d'autres modèles au model_list
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Composio (outils externes : Twitter/X, LinkedIn, Notion, Gmail...) ---
# Base API vérifiée : https://backend.composio.dev/api/v3.1  (header x-api-key)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=rouslan-picoclaw

# --- Telegram ---
# Token obtenu auprès de @BotFather
TELEGRAM_BOT_TOKEN=
# Ton user id numérique Telegram (via @userinfobot). Vide = aucun filtre,
# n'importe qui peut parler au bot : à éviter sur un Space public.
TELEGRAM_ALLOWED_USER_ID=

# --- Persistance externe (Lot D — webhook Make.com vers Google Sheets) ---
MAKE_PERSISTENCE_WEBHOOK_URL=

# --- Runtime ---
# Port : HF Spaces route le trafic public vers app_port (7860 par défaut).
PICOCLAW_GATEWAY_PORT=7860
PICOCLAW_GATEWAY_HOST=0.0.0.0
# Racine de données PicoClaw (config.json, workspace, skills, auth store).
PICOCLAW_HOME=/data/.picoclaw
