# Do NOT exclude LICENSE or .github — scripts/copydir.go uses them as repo-root anchors
# during `go generate`, which runs inside `make build` in the Dockerfile.
.git
.gitignore
build/
.picoclaw/
config/
# Exception : le template de deploiement doit entrer dans l'image (COPY dans le Dockerfile).
!config/config.hf.template.json
.env
.env.example
*.md
assets/
